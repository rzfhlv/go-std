{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "build",
  "permissions": [
    { "action": "bash", "resource": "make *", "effect": "allow" },
    { "action": "bash", "resource": "go *", "effect": "allow" },
    { "action": "bash", "resource": "golangci-lint *", "effect": "allow" },
    { "action": "bash", "resource": "gofumpt *", "effect": "allow" },
    { "action": "bash", "resource": "git *", "effect": "allow" },
    { "action": "bash", "resource": "rm -rf *", "effect": "deny" },
    { "action": "bash", "resource": "*", "effect": "ask" }
  ]
}
